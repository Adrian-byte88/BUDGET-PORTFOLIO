rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userEmail} {
      allow read, write: if request.auth != null && (request.auth.token.email == userEmail || request.auth.token.email == 'junnelmrfl@gmail.com');
    }

    match /users/{userEmail}/financialData/{dataId} {
      allow read, write: if request.auth != null && (request.auth.token.email == userEmail || request.auth.token.email == 'junnelmrfl@gmail.com');
    }
  }
}
